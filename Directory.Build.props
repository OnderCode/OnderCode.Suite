<Project>
  <!-- Bütün projeler için ortak ayarlar -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- NuGet güvenlik uyarıları görünür kalsın ama derlemeyi durdurmasın -->
    <WarningsNotAsErrors>$(WarningsNotAsErrors);NU1901;NU1902;NU1903;NU1904</WarningsNotAsErrors>
    <Deterministic>true</Deterministic>
    <Authors>Abdurrahman Önder</Authors>
    <Company>OnderCode</Company>
    <Product>OnderCode Suite</Product>
    <Copyright>© 2026 Abdurrahman Önder</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <Version>0.1.0</Version>
    <!-- Arayüz bileşenleri: Onda. Varsayılan olarak bu klasörün yanındaki Onda deposundan derlenir. -->
    <OndaProject Condition="'$(OndaProject)' == ''">$(MSBuildThisFileDirectory)..\Onda\src\Onda.WinForms\Onda.WinForms.csproj</OndaProject>
  </PropertyGroup>
</Project>
