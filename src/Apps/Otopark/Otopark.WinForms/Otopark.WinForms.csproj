<Project Sdk="Microsoft.NET.Sdk">
  <!-- OnderCode Otopark: otopark ve araç yıkama masaüstü arayüzü. Onda bileşenleri. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationHighDpiMode>SystemAware</ApplicationHighDpiMode>
    <RootNamespace>Otopark.WinForms</RootNamespace>
    <AssemblyName>OnderCodeOtopark</AssemblyName>
    <Product>OnderCode Otopark</Product>
    <AssemblyTitle>OnderCode Otopark</AssemblyTitle>
    <NoWarn>$(NoWarn);WFO1000</NoWarn>
    <UseOnda>true</UseOnda>
  </PropertyGroup>
  <ItemGroup>
    <Using Include="OnderCode.WinForms" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Otopark.Infrastructure\Otopark.Infrastructure.csproj" />
    <ProjectReference Include="..\..\..\Shared\OnderCode.WinForms\OnderCode.WinForms.csproj" />
  </ItemGroup>
</Project>
