<Project>
  <!-- Onda arayüz bileşenleri: <UseOnda>true</UseOnda> diyen projelere eklenir.
       Yanındaki Onda deposu varsa kaynaktan, yoksa bu depodaki derlenmiş kütüphaneden (lib\Onda). -->
  <ItemGroup Condition="'$(UseOnda)' == 'true'">
    <Using Include="Onda" />
  </ItemGroup>
  <ItemGroup Condition="'$(UseOnda)' == 'true' And Exists('$(OndaProject)') And '$(UseOndaDll)' != 'true'">
    <ProjectReference Include="$(OndaProject)" />
  </ItemGroup>
  <ItemGroup Condition="'$(UseOnda)' == 'true' And (!Exists('$(OndaProject)') Or '$(UseOndaDll)' == 'true')">
    <Reference Include="Onda.WinForms">
      <HintPath>$(MSBuildThisFileDirectory)lib\Onda\Onda.WinForms.dll</HintPath>
    </Reference>
  </ItemGroup>
  <!-- Onda.Web: <UseOndaWeb>true</UseOndaWeb> diyen web projelerine eklenir.
       Yanındaki Onda deposu varsa kaynaktan, yoksa bu depodaki derlenmiş kütüphaneden (lib\Onda\Onda.Web.dll).
       CSS/JS dll'in içine gömülü olduğu için tek dll yeterlidir. -->
  <ItemGroup Condition="'$(UseOndaWeb)' == 'true' And Exists('$(OndaWebProject)') And '$(UseOndaDll)' != 'true'">
    <ProjectReference Include="$(OndaWebProject)" />
  </ItemGroup>
  <ItemGroup Condition="'$(UseOndaWeb)' == 'true' And (!Exists('$(OndaWebProject)') Or '$(UseOndaDll)' == 'true')">
    <Reference Include="Onda.Web">
      <HintPath>$(MSBuildThisFileDirectory)lib\Onda\Onda.Web.dll</HintPath>
    </Reference>
  </ItemGroup>
</Project>
