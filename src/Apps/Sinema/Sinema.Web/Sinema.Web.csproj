<Project Sdk="Microsoft.NET.Sdk.Web">
  <!-- OnderCode Sinema: müşteri sitesi, yönetim paneli, gişe ve kapı ekranları. Blazor (sunucu) + Onda.Web bileşenleri. -->
  <PropertyGroup>
    <RootNamespace>Sinema.Web</RootNamespace>
    <AssemblyName>OnderCodeSinema</AssemblyName>
    <Product>OnderCode Sinema</Product>
    <UseOndaWeb>true</UseOndaWeb>
    <BlazorDisableThrowNavigationException>true</BlazorDisableThrowNavigationException>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Sinema.Infrastructure\Sinema.Infrastructure.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="QRCoder" />
  </ItemGroup>
  <ItemGroup>
    <Content Update="wwwroot\uploads\**" CopyToPublishDirectory="Never" />
  </ItemGroup>
</Project>
