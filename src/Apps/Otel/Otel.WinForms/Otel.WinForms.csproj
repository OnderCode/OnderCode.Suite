<Project Sdk="Microsoft.NET.Sdk">
  <!-- Otel otomasyonu masaüstü arayüzü. Standart WinForms kontrolleri yerine Onda bileşenleri. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationHighDpiMode>SystemAware</ApplicationHighDpiMode>
    <RootNamespace>Otel.WinForms</RootNamespace>
    <AssemblyName>OnderCodeOtel</AssemblyName>
    <Product>OnderCode Otel</Product>
    <AssemblyTitle>OnderCode Otel</AssemblyTitle>
    <!-- Özel kontrollerin verisi metotla verilir; tasarımcı serileştirme uyarısı bu proje için anlamsız -->
    <NoWarn>$(NoWarn);WFO1000</NoWarn>
    <UseOnda>true</UseOnda>
  </PropertyGroup>
  <ItemGroup>
    <Using Include="OnderCode.WinForms" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Otel.Infrastructure\Otel.Infrastructure.csproj" />
    <ProjectReference Include="..\..\..\Shared\OnderCode.WinForms\OnderCode.WinForms.csproj" />
  </ItemGroup>
</Project>
