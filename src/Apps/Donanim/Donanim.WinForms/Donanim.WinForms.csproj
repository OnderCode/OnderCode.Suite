<Project Sdk="Microsoft.NET.Sdk">
  <!-- OnderCode Donanım: donanım karnesi masaüstü uygulaması. Onda bileşenleri. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationHighDpiMode>SystemAware</ApplicationHighDpiMode>
    <RootNamespace>Donanim.WinForms</RootNamespace>
    <AssemblyName>OnderCodeDonanim</AssemblyName>
    <Product>OnderCode Donanım</Product>
    <AssemblyTitle>OnderCode Donanım</AssemblyTitle>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <Version>1.0.0</Version>
    <NoWarn>$(NoWarn);WFO1000</NoWarn>
    <UseOnda>true</UseOnda>
  </PropertyGroup>
  <ItemGroup>
    <Using Include="OnderCode.WinForms" />
    <Using Include="Donanim.Core" />
    <Using Include="System.Drawing.Drawing2D" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Donanim.Windows\Donanim.Windows.csproj" />
    <ProjectReference Include="..\..\..\Shared\OnderCode.WinForms\OnderCode.WinForms.csproj" />
  </ItemGroup>
</Project>
